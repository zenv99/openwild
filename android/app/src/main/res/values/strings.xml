    <!-- about -->
    <string name="created_by">Created by EDM producer Zen V</string>
    <string name="creator_bio">I\'m a US Marine, and we may be foraging for survival one day. This is the go-to app. Hope you enjoy.</string>
    <string name="gift_line">Free forever, open source, and private. A gift to anyone who finds themselves in the wild.</string>
    <string name="donate">Support OpenWild</string>
    <string name="donate_body">OpenWild is free with no ads. If it helped you, you can send a tip over Bitcoin Lightning:</string>
    <string name="donate_lightning">Tip with Lightning</string>
    <string name="copied_address">No Lightning wallet found. Address copied to clipboard.</string>
    <string name="feedback_title">Feedback</string>
    <string name="feedback_body">Found a bug, a wrong ID, or have an idea? Tell us. Nothing is sent until you press send.</string>
    <string name="feedback_send">Send feedback</string>

    <string name="privacy_title">100% private</string>
    <string name="privacy_body">OpenWild goes online for one thing only: downloading a region when you tap Download. It talks only to GitHub, where the regions are published, and sends nothing about you. Identification runs entirely on your phone, with or without signal. No account, no ads, no analytics, no tracking, no cloud backup. Photos and location never leave the device. Share and feedback buttons only hand text to another app when you tap them.</string>
    <string name="contribute_title">Help make it better</string>
    <string name="contribute_body">Botanists, mycologists and translators: every safety entry is reviewed by people. Share confirmed sightings on iNaturalist to help train future versions.</string>
    <string name="contribute_review">Review safety content</string>
    <string name="contribute_translate">Translate the app</string>
    <string name="contribute_inat">Post sightings on iNaturalist</string>

    <!-- Disclaimer (first run) -->
    <string name="disclaimer_title">Before you start</string>
    <string name="disclaimer_body">OpenWild helps you identify plants and mushrooms from photos, offline.\n\nPhoto identification can be wrong. Some deadly species look almost identical to edible ones.\n\nNever eat anything based only on this app. In an emergency, seek medical help.</string>

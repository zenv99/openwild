<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificates only (no user-installed CAs). The app only ever contacts GitHub,
     to download region packs (see PackManager.ALLOWED_HOSTS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificates only (no user-installed CAs). The app contacts GitHub for region
     packs and the photo inbox, and my-api.plantnet.org only after the person turns on Online check and taps it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
